## basic-all-depths
extract => ok
by package "P" => "de", "en", "es", "fr"
by packages (engine order) => "de", "en", "es", "fr"
## file-name-patterns
extract => ok
by package "P" => "aa", "bb", "cc", "ff", "gg"
by packages (engine order) => "aa", "bb", "cc", "ff", "gg"
## selection-rules
extract => ok
by package "P" => "", "child", "deepitem", "relchild"
by packages (engine order) => "", "child", "deepitem", "relchild"
## case-lowered-and-merged
extract => ok
by package "P" => "de", "\u0130", "zh-cn", "\u03B1\u03C3"
by packages (engine order) => "de", "\u0130", "zh-cn", "\u03B1\u03C3"
## two-packages
extract => ok
by package "P1" => "de", "fr"
by package "P2" => "de", "es"
by package "P3" => 
by package "Unknown" => 
by packages (engine order) => "de", "es", "fr"
by packages P1,P2 => "de", "es", "fr"
by packages P2,P1,P2 => "de", "es", "fr"
by packages none => 
## same-package-name-twice-first-wins
extract => ok
by package "P" => "de"
by packages (engine order) => "de"
## order-of-package-names-in-the-sort
## sort-order
extract => ok
by package "P" => "1", "10", "2", "a", "\u00E4", "a_b", "ab", "a-b", "b", "de", "de-ch", "dex", "e", "\u00E9", "en", "en-us", "f", "z", "zh", "zhcn", "zh-cn", "zh-tw"
by packages (engine order) => "1", "10", "2", "a", "\u00E4", "a_b", "ab", "a-b", "b", "de", "de-ch", "dex", "e", "\u00E9", "en", "en-us", "f", "z", "zh", "zhcn", "zh-cn", "zh-tw"
## sort-order-realistic
extract => ok
by package "P" => "da", "de", "dea", "de-ch", "en", "en-us", "es", "es-mx", "fr", "fr-ca", "nl", "nl-be", "pt", "pt-br", "sv", "sv-fi", "zh-cn", "zh-tw"
by packages (engine order) => "da", "de", "dea", "de-ch", "en", "en-us", "es", "es-mx", "fr", "fr-ca", "nl", "nl-be", "pt", "pt-br", "sv", "sv-fi", "zh-cn", "zh-tw"
## re-extract-clears-the-cache
after first extract, A => "de"
after second extract, A => 
after second extract, B => "fr"
after empty extract, B => 
