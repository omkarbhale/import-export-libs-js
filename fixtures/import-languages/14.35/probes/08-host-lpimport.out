lpimport complete => rc=0 console=""
    IMPORT="LPImport" RELEASE="R1" LPPATH="C:\\lp\\ImportConfig.xml" LPPACKAGE="PKG" LPDEBUG="False" DIR="" MFFILE="" MERGE="False" FASTMODE="False" DESCRIPTION="" VERBOSE="False" TIMEOUT="0"
lpimport with lpdebug => rc=0 console=""
    IMPORT="LPImport" RELEASE="R1" LPPATH="C:\\lp\\c.xml" LPPACKAGE="PKG" LPDEBUG="True" DIR="" MFFILE="" MERGE="False" FASTMODE="False" DESCRIPTION="" VERBOSE="False" TIMEOUT="0"
lpdebug not a bool => rc=0 console="\nfailed to parse  LPDEBUG yes\n"
    IMPORT="LPImport" RELEASE="R1" LPPATH="C:\\lp\\c.xml" LPPACKAGE="PKG" LPDEBUG="False" DIR="" MFFILE="" MERGE="False" FASTMODE="False" DESCRIPTION="" VERBOSE="False" TIMEOUT="0"
lpdebug bare word => rc=1 console="\r\nunrecognized option lpdebug"
lpdebug uppercase value => rc=0 console=""
    IMPORT="LPImport" RELEASE="R1" LPPATH="C:\\lp\\c.xml" LPPACKAGE="PKG" LPDEBUG="True" DIR="" MFFILE="" MERGE="False" FASTMODE="False" DESCRIPTION="" VERBOSE="False" TIMEOUT="0"
all options => rc=0 console=""
    IMPORT="LPImport" RELEASE="R1" LPPATH="C:\\lp\\c.xml" LPPACKAGE="PKG" LPDEBUG="False" DIR="C:\\x" MFFILE="m.mf" MERGE="True" FASTMODE="True" DESCRIPTION="foxwords" VERBOSE="True" TIMEOUT="0"
quoted values => rc=0 console=""
    IMPORT="LPImport" RELEASE="R 1" LPPATH="C:\\lp dir\\c.xml" LPPACKAGE="PKG" LPDEBUG="False" DIR="" MFFILE="" MERGE="False" FASTMODE="False" DESCRIPTION="" VERBOSE="False" TIMEOUT="0"
missing release => rc=1 console="\nParam error : release param can't be empty"
missing lppath => rc=1 console="\nParam error : language pack path can't be empty"
missing lppackage => rc=1 console="\nParam error : language pack package name can't be empty"
missing both lp args => rc=1 console="\nParam error : language pack path can't be empty"
empty lppath value => rc=1 console="\r\nunrecognized option lppath="
path with equals sign => rc=1 console="\r\nunrecognized option lppath=C:\\a"
unknown option => rc=1 console="\r\nunrecognized option colour"
lp options without lpimport (import) => rc=0 console=""
    IMPORT="Import" RELEASE="R1" LPPATH="C:\\lp\\c.xml" LPPACKAGE="PKG" LPDEBUG="False" DIR="C:\\x" MFFILE="" MERGE="False" FASTMODE="False" DESCRIPTION="" VERBOSE="False" TIMEOUT="0"
password empty => rc=1 console="\r\nunrecognized option password="
both import and lpimport (last wins) => rc=0 console=""
    IMPORT="LPImport" RELEASE="R1" LPPATH="C:\\lp\\c.xml" LPPACKAGE="PKG" LPDEBUG="False" DIR="" MFFILE="" MERGE="False" FASTMODE="False" DESCRIPTION="" VERBOSE="False" TIMEOUT="0"
