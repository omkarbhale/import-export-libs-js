## 10 XPath failure shapes (AddPackage on a fresh manifest)
AddPackage "'" => System.Xml.XPath.XPathException: "This is an unclosed string."
AddPackage "a'" => System.Xml.XPath.XPathException: "This is an unclosed string."
AddPackage "'a" => System.Xml.XPath.XPathException: "'imports/package[@name=''a']' has an invalid token."
AddPackage "a''b" => System.Xml.XPath.XPathException: "'imports/package[@name='a''b']' has an invalid token."
AddPackage "a' and 'b" => "<package name=\"a' and 'b\" path=\"a' and 'b\\Import\" />"
AddPackage "x'] | //package[@name='My.Pkg" => "<package name=\"My.Pkg\" path=\"Pkg\\Import\" />"
AddPackage "x' or ''='" => "<package name=\"My.Pkg\" path=\"Pkg\\Import\" />"
AddPackage "x' or 1=1 or '" => "<package name=\"My.Pkg\" path=\"Pkg\\Import\" />"
AddPackage "x')" => System.Xml.XPath.XPathException: "'imports/package[@name='x')']' has an invalid token."
AddPackage "x'[1]" => System.Xml.XPath.XPathException: "Expression must evaluate to a node-set."
AddPackage "x' or @name='My.Pkg" => "<package name=\"My.Pkg\" path=\"Pkg\\Import\" />"
AddPackage "a'b'c" => System.Xml.XPath.XPathException: "'imports/package[@name='a'b'c']' has an invalid token."
AddPackage "x' or true() or @name='" => "<package name=\"My.Pkg\" path=\"Pkg\\Import\" />"
AddPackage "x' or contains(@name,'My') or @name='" => "<package name=\"My.Pkg\" path=\"Pkg\\Import\" />"
## 11 GetSolutionPath
GetSolutionPath "My.Pkg" => "C:\\m\\Pkg\\Import"
GetSolutionPath "com.aras.innovator.core" => "C:\\m\\.\\\\com\\aras\\innovator\\core"
GetSolutionPath "NoPath" => "C:\\m\\.\\"
GetSolutionPath "Blank" => "C:\\m\\.\\"
GetSolutionPath "Missing" => System.Exception: "Node for package 'Missing' doesn't exist in the manifest file Enable to detemine path to Missing."
GetSolutionPath "" => System.Exception: "Node for package '' doesn't exist in the manifest file Enable to detemine path to ."
GetSolutionPath "" => System.Exception: "Node for package '' doesn't exist in the manifest file Enable to detemine path to ."
GetSolutionPath "x'y" => System.Exception: "'imports/package[@name='x'y']' has an invalid token. Enable to detemine path to x'y."
GetSolutionPath manifest=null => System.ArgumentNullException: "Value cannot be null.\r\nParameter name: manifestFile"
GetSolutionPath illegal path => System.Exception: "Illegal characters in path. Enable to detemine path to Bad."
GetSolutionPath folder=null => System.Exception: "Node for package 'Bad' doesn't exist in the manifest file Enable to detemine path to Bad."
GetSolutionPath folder=null => System.Exception: "Value cannot be null.\r\nParameter name: path1 Enable to detemine path to com.aras.innovator.core."
GetSolutionPath My.Pkg folder=null => System.Exception: "Value cannot be null.\r\nParameter name: path1 Enable to detemine path to My.Pkg."
GetPackagePath path attr missing (NoPath) => "C:\\m\\.\\"
