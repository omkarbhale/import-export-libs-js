{
  "name": "import-export-libs-js",
  "version": "0.0.0",
  "private": true,
  "description": "A readable TypeScript re-implementation of Aras's package import/export engine (Libs.dll), reproducing engines 12.0, 14.0.7 and 14.35 exactly.",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "browser": "./dist/browser.js",
      "import": "./dist/index.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser.js"
    }
  },
  "bin": {
    "import-export-libs-js": "./dist/cli.js",
    "aras-pkg": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup && tsup --config tsup.browser.config.ts",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.browser.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "oracle": "tsx oracle/src/cli.ts",
    "parity": "tsx oracle/src/parity/cli.ts",
    "oracle:export-cases": "tsx oracle/src/record-export-cases.ts",
    "oracle:export-scratch-cases": "tsx oracle/src/record-export-scratch-cases.ts",
    "oracle:import-cases": "tsx oracle/src/record-import-cases.ts",
    "oracle:engine-diff": "tsx oracle/src/record-engine-diff.ts",
    "oracle:dbpatch-cases": "tsx oracle/src/record-dbpatch-cases.ts",
    "oracle:lp-cases": "tsx oracle/src/record-lp-cases.ts",
    "prepare": "npm run build",
    "rea-map": "tsx tools/rea-map/cli.ts"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "ajv": "^8.20.0",
    "buffer": "6.0.3",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@xmldom/xmldom": "0.9.12",
    "xpath": "0.0.34"
  }
}
