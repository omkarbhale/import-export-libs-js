{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/omkarbhale/import-export-libs-js/spec/reachable.schema.json",
  "title": "Libs.dll reachable set",
  "description": "Generated by tools/rea-map; never edited by hand. Every method of one build that its hosts can reach, with its REA method lock and where ILSpy's C# for it sits under .decomp/<engine>/.",
  "type": "object",
  "additionalProperties": false,
  "required": ["engine", "assemblyVersion", "sha256", "mvid", "generator", "hosts", "methods"],
  "properties": {
    "$schema": { "type": "string" },
    "engine": { "enum": ["12.0", "14.0.7", "14.35"] },
    "assemblyVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "sha256": { "$ref": "source-map.schema.json#/$defs/sha256" },
    "mvid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "generator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rea", "ilspycmd"],
      "properties": {
        "rea": { "type": "string" },
        "ilspycmd": { "type": "string" }
      }
    },
    "hosts": {
      "description": "The host executables whose references to Libs seeded the walk.",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["file", "sha256"],
        "properties": {
          "file": { "type": "string", "minLength": 1 },
          "sha256": { "$ref": "source-map.schema.json#/$defs/sha256" }
        }
      }
    },
    "methods": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["fullName", "signature", "lock"],
        "properties": {
          "fullName": { "type": "string", "pattern": "^[^:]+::[^:]+$" },
          "signature": { "type": "string", "minLength": 1 },
          "lock": { "$ref": "source-map.schema.json#/$defs/lock" },
          "decomp": {
            "description": "The method's C# under .decomp/<engine>/: a project-relative path and 1-based inclusive lines.",
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "startLine", "endLine"],
            "properties": {
              "path": { "type": "string", "minLength": 1 },
              "startLine": { "type": "integer", "minimum": 1 },
              "endLine": { "type": "integer", "minimum": 1 }
            }
          }
        }
      }
    }
  }
}
